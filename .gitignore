# ==============================================================================
# Git Ignore - Multi-Agent Financial Statement Analysis System
# ==============================================================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets (NEVER commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# Raw and processed financial data (PDFs, raw reports)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/chroma_db/*
!data/chroma_db/.gitkeep
data/embeddings_cache/*
!data/embeddings_cache/.gitkeep
data/training/*
!data/training/.gitkeep
*.db
*.sqlite
*.sqlite3
*.xlsx
*.xls


# Logs and application run data
logs/*
!logs/.gitkeep
*.log

# MLOps & Experiment Tracking
mlruns/
wandb/
.langchain.db

# Testing and code quality
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# Local Vector DB & Sandbox data
.chroma/
chroma_data/
mysql_data/

# Node.js & Web Frontend Dependencies (NEVER commit node_modules)
node_modules/
*/node_modules/
dist/
*/dist/
.vite/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS specific files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
