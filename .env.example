# ==============================================================================
# FINANCIAL MULTI-AGENT SYSTEM CONFIGURATION (.env.example)
# ==============================================================================

# 1. Google Gemini API Key
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud API Key (Miễn phí 100%, tốc độ 300 token/s, không lo hết quota)
# Lấy key miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter API Key (Tùy chọn - Dùng DeepSeek-R1, Qwen-2.5 free)
# Lấy key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Jina AI Token (Mô hình nhúng jina-embeddings-v3 / Miễn phí 10 triệu tokens)
# Lấy token miễn phí tại: https://cloud.jina.ai/
JINA_TOKEN=your_jina_token_here

# 5. MySQL Database Config (Tùy chọn)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=financial_db
