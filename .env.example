# ==============================================================================
# Multi-Agent Financial Statement Analysis System - Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Keys (100% Free Tier Supported)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Optional: Groq API Key for fast open-source models (Free at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Local Ollama URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: OpenAI API Key (if using paid OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Database Configurations (Docker Compose defaults)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=financial_db
MYSQL_USER=finagent_user
MYSQL_PASSWORD=finagent_pass
MYSQL_ROOT_PASSWORD=root_password

CHROMA_HOST=localhost
CHROMA_PORT=8000

# ------------------------------------------------------------------------------
# 3. Observability & Tracking (Optional - LangSmith Free Tier)
# ------------------------------------------------------------------------------
# Get free key at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=finagent-vietnam

# ------------------------------------------------------------------------------
# 4. Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
